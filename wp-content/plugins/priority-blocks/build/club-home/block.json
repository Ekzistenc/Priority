{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "snd/club-home",
  "version": "0.1.0",
  "title": "Клубный дом",
  "category": "snd-blocks",
  "icon": "align-center",
  "example": {},
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "title_01": {
      "type": "string",
      "default": "Запишитесь на экскурсию"
    },
    "title_02": {
      "type": "string",
      "default": "Собственными глазами увидите стройплошадку,"
    },
    "title_03": {
      "type": "string",
      "default": "сможете подняться на любой этаж и&nbsp;протестировать любую планировку"
    },
    "image": {
      "type": "object",
      "default": {
        "id": 0,
        "url": "",
        "alt": ""
      }
    },
    "video": {
      "type": "object",
      "default": {
        "id": 0,
        "url": "",
        "poster": {
          "id": 0,
          "url": ""
        }
      }
    },
    "description_01": {
      "type": "string",
      "default": "Видео помогает представить будущий дом, "
    },
    "description_02": {
      "type": "string",
      "default": "но личная экскурсия даёт совершенно другие ощущения!"
    },
    "button": {
      "type": "object",
      "default": {
        "text": "Записаться на экскурсию",
        "link": "/",
        "target": false,
        "modal": true,
        "show": true
      }
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}