{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "snd/main-swiper-wrapper",
  "version": "0.1.1",
  "title": "Посадочный блок обертка",
  "category": "snd-blocks",
  "icon": "cover-image",
  "example": {
    "viewportWidth": 1200
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [
    "swiper",
    "file:./style-index.css"
  ],
  "viewScript": [
    "swiper",
    "file:./view.js"
  ],
  "render": "file:./render.php"
}