{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "snd/about-blue",
	"version": "0.1.1",
	"title": "О компании миссия",
	"category": "snd-blocks",
	"icon": "editor-paste-text",
	"parent": [ "snd/about-wrapper" ],
	"example": {
		"viewportWidth": 1200
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"title": {
			"type": "string",
			"default": "Мы делаем то, что делаем, потому что верим в свою миссию:"
		},
		"subtitle": {
			"type": "string",
			"default": "изменяя городское пространство, мы изменяем будущее городов к лучшему. А значит — и ваше тоже!"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": [ "file:./style-index.css" ],
	"render": "file:./render.php"
}
