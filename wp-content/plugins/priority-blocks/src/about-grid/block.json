{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "snd/about-grid",
	"version": "0.1.0",
	"title": "Сетка проектов",
	"category": "snd-blocks",
	"icon": "grid-view",
	"parent": [ "snd/about-content" ],
	"example": {
		"viewportWidth": 1200
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"projects": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": [ "file:./style-index.css" ],
	"render": "file:./render.php"
}
